# 伺服器埠號
PORT=3000

# 累積資料的資料夾（部署時要放在不會被清掉的磁碟）
DATA_DIR=./data

# 設了之後開網頁會要求輸入密碼（帳號隨意）
APP_PASSWORD=

# 首次回補的股價天數、法人天數
PRICE_DAYS=90
INST_DAYS=15

# 自動排程（台北時間，cron 格式）。CRON_ENABLED=0 可關閉
CRON_ENABLED=1
CRON_DAILY=40 17 * * 1-5
CRON_WEEKLY=30 10 * * 6

# 啟動時自動更新資料（第一次會自動建立歷史資料）
AUTO_UPDATE_ON_START=1
