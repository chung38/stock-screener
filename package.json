{
  "name": "resonance-screener",
  "version": "1.0.0",
  "private": true,
  "description": "台股三重共振選股：基本面爆發＋籌碼進駐＋技術面突破",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "update": "node server/cli.js update",
    "backfill": "node server/cli.js backfill",
    "research-data": "node server/cli.js research-data",
    "dividends": "node server/cli.js dividends",
    "research": "node --max-old-space-size=6000 server/cli.js research",
    "diagnose": "node server/cli.js diagnose",
    "selftest": "node server/selftest.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.6.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
